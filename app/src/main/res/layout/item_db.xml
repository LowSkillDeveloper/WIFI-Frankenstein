<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="2dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:strokeColor="?attr/colorPrimary"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <TextView
            android:id="@+id/textViewDbType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:textAppearance="?attr/textAppearanceSubtitle2"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintEnd_toStartOf="@+id/chipDbType"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="SQLite file (3WiFi type)" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipDbType"
            style="@style/Widget.MaterialComponents.Chip.Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:ellipsize="end"
            android:lines="1"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textSize="11sp"
            android:visibility="gone"
            app:chipMinHeight="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/textViewDbType"
            app:layout_constraintEnd_toStartOf="@+id/buttonDbDetails"
            app:layout_constraintStart_toEndOf="@+id/textViewDbType"
            app:layout_constraintTop_toTopOf="@+id/textViewDbType"
            tools:text="3WiFi"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/buttonDbDetails"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/details"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_info"
            app:layout_constraintBottom_toBottomOf="@+id/textViewDbType"
            app:layout_constraintEnd_toStartOf="@+id/buttonRemove"
            app:layout_constraintTop_toTopOf="@+id/textViewDbType"
            app:tint="?attr/colorPrimary" />

        <ImageButton
            android:id="@+id/buttonRemove"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/remove_database"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:src="@drawable/delete_forever_24px"
            app:layout_constraintBottom_toBottomOf="@+id/buttonDbDetails"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/buttonDbDetails"
            app:tint="?attr/colorError" />

        <TextView
            android:id="@+id/textViewDbPath"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:lines="1"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceCaption"
            app:layout_constraintEnd_toStartOf="@+id/buttonRemove"
            app:layout_constraintStart_toStartOf="@+id/textViewDbType"
            app:layout_constraintTop_toBottomOf="@+id/textViewDbType"
            tools:text="database.db" />

        <TextView
            android:id="@+id/textViewDbSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceCaption"
            app:layout_constraintStart_toStartOf="@+id/textViewDbPath"
            app:layout_constraintTop_toBottomOf="@+id/textViewDbPath"
            tools:text="24.5 MB / 12.3 MB" />

        <TextView
            android:id="@+id/textViewOldFormatWarning"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="@color/warning_orange"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@+id/textViewDbPath"
            app:layout_constraintStart_toStartOf="@+id/textViewDbPath"
            app:layout_constraintTop_toBottomOf="@+id/textViewDbSize"
            tools:text="This database uses old format"
            tools:visibility="visible" />
        <TextView
            android:id="@+id/textViewIndexStatusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/index_status_label"
            android:textAppearance="?attr/textAppearanceCaption"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@+id/textViewDbPath"
            app:layout_constraintTop_toBottomOf="@+id/textViewOldFormatWarning"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/textViewIndexStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/not_indexed"
            android:textAppearance="?attr/textAppearanceCaption"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/textViewIndexStatusLabel"
            app:layout_constraintStart_toEndOf="@+id/textViewIndexStatusLabel"
            app:layout_constraintTop_toTopOf="@+id/textViewIndexStatusLabel"
            tools:visibility="visible" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonManageIndexes"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="4dp"
            android:minWidth="0dp"
            android:minHeight="28dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="@string/index_database"
            android:textSize="11sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@+id/textViewIndexStatusLabel"
            app:layout_constraintTop_toBottomOf="@+id/textViewIndexStatusLabel"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/textViewMain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Main"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="?attr/colorSecondary"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/textViewDbPath"
            app:layout_constraintEnd_toEndOf="@+id/textViewDbPath"
            app:layout_constraintTop_toTopOf="@+id/textViewDbPath"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/imageDragHandle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/drag_handle"
            android:src="@drawable/ic_drag_handle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/buttonManageIndexes"
            app:tint="?attr/colorPrimary" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>

