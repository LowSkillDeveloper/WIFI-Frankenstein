<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_wifi_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/divider_color"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/signal_indicator"
            android:layout_width="22dp"
            android:layout_height="0dp"
            android:gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:paddingBottom="3dp"
            app:layout_constraintBottom_toBottomOf="@+id/bssid_text_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/signal_bar_1"
                android:layout_width="4dp"
                android:layout_height="6dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/signal_bar_bg" />

            <View
                android:id="@+id/signal_bar_2"
                android:layout_width="4dp"
                android:layout_height="10dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/signal_bar_bg" />

            <View
                android:id="@+id/signal_bar_3"
                android:layout_width="4dp"
                android:layout_height="14dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/signal_bar_bg" />

            <View
                android:id="@+id/signal_bar_4"
                android:layout_width="4dp"
                android:layout_height="18dp"
                android:background="@drawable/signal_bar_bg" />
        </LinearLayout>

        <TextView
            android:id="@+id/ssid_text_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@+id/security_icon"
            app:layout_constraintStart_toEndOf="@+id/signal_indicator"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="MyWiFiNetwork" />

        <TextView
            android:id="@+id/untrusted_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/info_badge_background"
            android:paddingStart="6dp"
            android:paddingTop="1dp"
            android:paddingEnd="6dp"
            android:paddingBottom="1dp"
            android:text="@string/wifi_untrusted"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="@color/error_red"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/ssid_text_view"
            app:layout_constraintStart_toEndOf="@+id/ssid_text_view"
            app:layout_constraintTop_toTopOf="@+id/ssid_text_view"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/bssid_text_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="?android:attr/textColorSecondary"
            app:layout_constraintEnd_toStartOf="@+id/signal_container"
            app:layout_constraintStart_toEndOf="@+id/signal_indicator"
            app:layout_constraintTop_toBottomOf="@+id/ssid_text_view"
            tools:text="00:11:22:33:44:55" />

        <LinearLayout
            android:id="@+id/signal_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/level_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBody2"
                android:textStyle="bold"
                tools:text="-65 dBm" />

            <TextView
                android:id="@+id/distance_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textColor="?android:attr/textColorSecondary"
                tools:text="~10m" />
        </LinearLayout>

        <ImageView
            android:id="@+id/wps_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="4dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/ssid_text_view"
            app:layout_constraintEnd_toStartOf="@+id/security_icon"
            app:layout_constraintTop_toTopOf="@+id/ssid_text_view"
            app:srcCompat="@drawable/wifi_protected_setup_24px"
            app:tint="@color/blue_500"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/security_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/ssid_text_view"
            app:layout_constraintEnd_toStartOf="@+id/signal_container"
            app:layout_constraintTop_toTopOf="@+id/ssid_text_view"
            app:srcCompat="@drawable/ic_lock"
            app:tint="?attr/colorPrimary" />

        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/chips_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:alignContent="flex_start"
            app:alignItems="center"
            app:flexWrap="wrap"
            app:justifyContent="flex_start"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bssid_text_view">

            <TextView
                android:id="@+id/channel_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/info_badge_background"
                android:ellipsize="none"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="CH 11" />

            <TextView
                android:id="@+id/frequency_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/info_badge_background"
                android:ellipsize="none"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="2.4GHz" />

            <TextView
                android:id="@+id/bandwidth_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/info_badge_background"
                android:ellipsize="none"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="40MHz" />

            <TextView
                android:id="@+id/protocol_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/info_badge_background"
                android:ellipsize="none"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="WiFi6"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/protocol_full_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/info_badge_background"
                android:ellipsize="none"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="802.11ax"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/security_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/info_badge_background"
                android:ellipsize="none"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="WPA2/WPA3" />

            <TextView
                android:id="@+id/security_types_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/info_badge_background"
                android:ellipsize="none"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="PSK+SAE"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/wps_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/info_badge_background"
                android:ellipsize="none"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="WPS"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/pixie_dust_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/info_badge_background"
                android:ellipsize="none"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textColor="?attr/colorError"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="PixieDust"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/adhoc_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/info_badge_background"
                android:ellipsize="none"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Ad-hoc"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/fast_roaming_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/info_badge_background"
                android:ellipsize="none"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="802.11k/r/v"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/rtt_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/info_badge_background"
                android:ellipsize="none"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="RTT"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/ntb_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/info_badge_background"
                android:ellipsize="none"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="NTB"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/twt_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/info_badge_background"
                android:ellipsize="none"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="TWT"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/mld_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:background="@drawable/info_badge_background"
                android:ellipsize="none"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="MLD"
                tools:visibility="visible" />
        </com.google.android.flexbox.FlexboxLayout>

        <View
            android:id="@+id/divider_db"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:alpha="0.12"
            android:background="@color/divider_color"
            app:layout_constraintTop_toBottomOf="@id/chips_container" />

        <TextView
            android:id="@+id/records_count_text_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/spectrum_color_1"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@+id/expand_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider_db"
            tools:text="3 records in 2 databases"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/expand_button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/show_database_info"
            android:textSize="12sp"
            android:visibility="gone"
            app:icon="@drawable/ic_expand_more"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider_db"
            tools:visibility="visible" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxHeight="300dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/expand_button">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/credentials_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/expand_all_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/show_all_credentials"
            android:visibility="gone"
            app:icon="@drawable/ic_expand_more"
            app:iconGravity="textStart"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/scroll_view" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>

