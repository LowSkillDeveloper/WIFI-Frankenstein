<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="0dp"
    android:paddingTop="16dp"
    android:paddingEnd="0dp"
    android:paddingBottom="8dp">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cb_cross_check"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pm_setup_cross_check" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cb_wpasec"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pm_setup_wpasec" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cb_keep_screen_on"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pm_setup_keep_screen_on" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/pm_scan_rate_title"
        android:textAppearance="?attr/textAppearanceTitleSmall" />

    <RadioGroup
        android:id="@+id/rg_scan_rate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rb_adaptive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pm_scan_adaptive" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rb_still"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pm_scan_tier_still" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rb_walk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pm_scan_tier_walk" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rb_drive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pm_scan_tier_drive" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rb_very_fast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pm_scan_tier_very_fast" />
    </RadioGroup>
</LinearLayout>
