<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/dialogSwitchExperimental"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/include_experimental_algorithms"
                android:textAppearance="?attr/textAppearanceSubtitle1" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/dialogSwitchSearchDatabases"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/search_in_databases"
                android:textAppearance="?attr/textAppearanceSubtitle1" />

            <LinearLayout
                android:id="@+id/dialogLayoutDatabaseOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/dialogSwitchIncludeInApp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/include_inapp_database"
                    android:textAppearance="?attr/textAppearanceSubtitle1" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/dialogSwitchIncludeOffline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/include_offline_databases"
                    android:textAppearance="?attr/textAppearanceSubtitle1" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/dialogSwitchIncludeOnline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/include_online_databases"
                    android:textAppearance="?attr/textAppearanceSubtitle1" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/dialogSwitchIncludeLocal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/include_local_database"
                    android:textAppearance="?attr/textAppearanceSubtitle1" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/dialogSwitchIncludeNeighbors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/include_neighbor_search"
                    android:textAppearance="?attr/textAppearanceSubtitle1" />

                <RadioGroup
                    android:id="@+id/dialogRadioGroupNeighborDistance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <RadioButton
                        android:id="@+id/dialogRadioNeighborClose"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/neighbor_close"
                        android:textAppearance="?attr/textAppearanceSubtitle1" />

                    <RadioButton
                        android:id="@+id/dialogRadioNeighborMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="@string/neighbor_medium"
                        android:textAppearance="?attr/textAppearanceSubtitle1" />

                    <RadioButton
                        android:id="@+id/dialogRadioNeighborFar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/neighbor_far"
                        android:textAppearance="?attr/textAppearanceSubtitle1" />
                </RadioGroup>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dialogButtonSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/save"
        app:icon="@drawable/ic_check" />
</LinearLayout>

